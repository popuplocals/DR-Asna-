<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__contact">
      <a href="<%= site.contact.phoneHref %>"><%- icon('phone', 16) %> <span><%= site.contact.phone %></span></a>
      <a href="mailto:<%= site.contact.email %>"><%- icon('mail', 16) %> <span><%= site.contact.email %></span></a>
      <span class="topbar__hours"><%- icon('clock', 16) %> <span><%= site.contact.hours %></span></span>
    </div>
    <ul class="social social--top" aria-label="Social media">
      <% site.social.forEach(s => { %>
        <li><a href="<%= s.url %>" target="_blank" rel="noopener" aria-label="<%= s.name %>"><%- icon(s.icon, 16) %></a></li>
      <% }) %>
    </ul>
  </div>
</div>

<header class="header" id="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label="Can X Global home">
      <img src="/img/logo.svg?v=<%= assetVersion %>" alt="Can X Global" width="214" height="44" fetchpriority="high">
    </a>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="primaryNav" aria-label="Open menu">
      <%- icon('menu', 26, 'nav-toggle__open') %>
      <%- icon('x', 26, 'nav-toggle__close') %>
    </button>

    <nav class="nav" id="primaryNav" aria-label="Primary">
      <ul class="nav__list">
        <% site.nav.forEach(item => { %>
          <% if (item.mega) { %>
            <li class="nav__item has-dropdown has-mega">
              <a class="nav__link" href="<%= wp(item.href) %>"><%= item.label %> <%- icon('chevron-down', 14) %></a>
              <button class="nav__sub-toggle" aria-expanded="false" aria-label="Toggle <%= item.label %> submenu"><%- icon('chevron-down', 18) %></button>
              <div class="mega">
                <% item.columns.forEach(col => { %>
                  <div class="mega__col">
                    <a class="mega__title" href="<%= wp(col.href) %>"><%= col.title %></a>
                    <ul>
                      <% col.links.forEach(l => { %>
                        <li><a href="<%= wp(l.href) %>"><%= l.label %></a></li>
                      <% }) %>
                    </ul>
                  </div>
                <% }) %>
              </div>
            </li>
          <% } else if (item.children) { %>
            <li class="nav__item has-dropdown">
              <a class="nav__link" href="<%= wp(item.href) %>"><%= item.label %> <%- icon('chevron-down', 14) %></a>
              <button class="nav__sub-toggle" aria-expanded="false" aria-label="Toggle <%= item.label %> submenu"><%- icon('chevron-down', 18) %></button>
              <ul class="dropdown">
                <% item.children.forEach(c => { %>
                  <li><a href="<%= wp(c.href) %>"><strong><%= c.label %></strong><% if (c.desc) { %><small><%= c.desc %></small><% } %></a></li>
                <% }) %>
              </ul>
            </li>
          <% } else { %>
            <li class="nav__item"><a class="nav__link" href="<%= wp(item.href) %>"><%= item.label %></a></li>
          <% } %>
        <% }) %>
      </ul>
      <div class="nav__cta">
        <a class="btn btn--primary" href="<%= wp(site.cta.href) %>"><%= site.cta.label %></a>
      </div>
    </nav>
  </div>
</header>
