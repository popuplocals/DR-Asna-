<footer class="footer" id="footer">
  <div class="container footer__grid">
    <div class="footer__about">
      <a class="brand brand--footer" href="/" aria-label="Can X Global home">
        <img src="/img/logo-white.svg?v=<%= assetVersion %>" alt="Can X Global" width="214" height="44" loading="lazy">
      </a>
      <p><%= site.footer.about %></p>
      <ul class="social" aria-label="Social media">
        <% site.social.forEach(s => { %>
          <li><a href="<%= s.url %>" target="_blank" rel="noopener" aria-label="<%= s.name %>"><%- icon(s.icon, 18) %></a></li>
        <% }) %>
      </ul>
    </div>

    <% site.footer.columns.forEach(col => { %>
      <div class="footer__col">
        <h3><%= col.title %></h3>
        <ul>
          <% col.links.forEach(l => { %>
            <li><a href="<%= wp(l.href) %>"><%= l.label %></a></li>
          <% }) %>
        </ul>
      </div>
    <% }) %>

    <div class="footer__col footer__contact">
      <h3>Contact</h3>
      <ul>
        <li><%- icon('map-pin', 18) %><a href="<%= site.contact.mapsUrl %>" target="_blank" rel="noopener"><%= site.contact.address %><br><%= site.contact.city %></a></li>
        <li><%- icon('phone', 18) %><a href="<%= site.contact.phoneHref %>"><%= site.contact.phone %></a></li>
        <li><%- icon('printer', 18) %><span>Fax: <%= site.contact.fax %></span></li>
        <li><%- icon('mail', 18) %><a href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a></li>
        <li><%- icon('clock', 18) %><span><%= site.contact.hours %><br><%= site.contact.hoursClosed %></span></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; <%= year %> <%= site.footer.copyright %></p>
      <ul>
        <% site.footer.legal.forEach(l => { %>
          <li><a href="<%= wp(l.href) %>"><%= l.label %></a></li>
        <% }) %>
      </ul>
    </div>
  </div>
</footer>

<a class="float-call" href="<%= site.contact.phoneHref %>" aria-label="Call Can X Global"><%- icon('phone', 22) %></a>
<button class="to-top" id="toTop" aria-label="Back to top" hidden><%- icon('chevron-down', 20) %></button>
</body>
</html>
