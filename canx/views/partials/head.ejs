<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.description %>">
  <meta name="theme-color" content="#0b2545">
  <link rel="canonical" href="<%= wpBaseUrl %>/">
  <link rel="icon" href="/img/favicon.svg?v=<%= assetVersion %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/favicon.svg?v=<%= assetVersion %>">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site.meta.siteName %>">
  <meta property="og:title" content="<%= page.title %>">
  <meta property="og:description" content="<%= page.description %>">
  <meta property="og:url" content="<%= wpBaseUrl %>/">
  <meta property="og:image" content="<%= wpBaseUrl %>/img/og-canx.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@canxglobal">

  <link rel="preload" href="/css/style.css?v=<%= assetVersion %>" as="style">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script src="/js/main.js?v=<%= assetVersion %>" defer></script>

  <script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Can X Global Solutions Inc.',
    url: wpBaseUrl + '/',
    telephone: site.contact.phone,
    email: site.contact.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.contact.address,
      addressLocality: 'Surrey',
      addressRegion: 'BC',
      postalCode: 'V3V 0E8',
      addressCountry: 'CA'
    },
    openingHours: 'Mo-Fr 09:00-17:00',
    sameAs: site.social.map(s => s.url),
    founder: { '@type': 'Person', name: site.story.founder.name, jobTitle: 'Licensed RCIC' },
    areaServed: 'Canada',
    description: page.description
  }) %>
  </script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
