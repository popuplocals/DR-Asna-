# Port the Node server listens on
PORT=3000

# Base URL of the existing WordPress site. Every inner-page link on the
# homepage (Employers, Immigration, Blog, Contact...) points here.
WP_BASE_URL=https://canxglobal.com

# Set to "production" to enable template caching and long-lived asset caching
NODE_ENV=production

# Directory for assets fetched on demand from WordPress (Elementor widget chunks…)
# ASSET_CACHE_DIR=.asset-cache
